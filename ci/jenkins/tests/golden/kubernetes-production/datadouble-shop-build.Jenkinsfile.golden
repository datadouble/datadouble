// Generated by `datadouble ci init` (Datadouble 1.2.3). Change the spec or
// the options and generate it again, rather than editing it by hand. Run it
// as the Pipeline job datadouble-shop-build.

library(identifier: 'datadouble@v1.2.3', retriever: modernSCM(
    scm: [$class: 'GitSCMSource', remote: 'https://github.com/datadouble/datadouble.git'],
    libraryPath: 'ci/jenkins/'))

pipeline {
    agent {
        kubernetes {
            cloud 'prod-k8s'
            namespace 'shop-production'
            yaml '''
                apiVersion: v1
                kind: Pod
                spec:
                  serviceAccountName: datadouble-shop-production
                  containers:
                  - name: jnlp
                    command:
                    - /bin/sh
                    - -c
                    - umask 0000 && exec /usr/local/bin/jenkins-agent "$@"
                    - jenkins-agent
                  - name: datadouble
                    image: ghcr.io/datadouble/datadouble:v1.2.3
                    command:
                    - sleep
                    args:
                    - infinity
                    securityContext:
                      runAsUser: 999
                      runAsGroup: 999
                      runAsNonRoot: true
                      allowPrivilegeEscalation: false
                    volumeMounts:
                    - name: work
                      mountPath: /srv/datadouble
                    - name: boundary
                      mountPath: /etc/datadouble-boundary
                      readOnly: true
                  volumes:
                  - name: work
                    persistentVolumeClaim:
                      claimName: datadouble
                  - name: boundary
                    configMap:
                      name: datadouble-boundary
                      optional: true
                  imagePullSecrets:
                  - name: registry
                '''
        }
    }
    options {
        disableConcurrentBuilds()
        timeout(time: 720, unit: 'MINUTES')
    }
    parameters {
        string(name: 'RETRY_KEY', description: 'To resume a failed build, its BUILD_TAG')
    }
    triggers {
        cron('TZ=UTC\n0 2 * * 1')
    }
    stages {
        stage('datadouble run') {
            steps {
                withCredentials([string(credentialsId: 'ALERTS_WEBHOOK', variable: 'ALERTS_WEBHOOK'), string(credentialsId: 'COSIGN_PASSWORD', variable: 'COSIGN_PASSWORD'), string(credentialsId: 'SHOP_COSIGN_KEY', variable: 'SHOP_COSIGN_KEY'), string(credentialsId: 'SHOP_SOURCE_DSN', variable: 'SHOP_SOURCE_DSN')]) {
                    datadouble(
                        job: 'build',
                        container: 'datadouble',
                        environment: ['ALERTS_WEBHOOK', 'COSIGN_PASSWORD', 'SHOP_COSIGN_KEY', 'SHOP_SOURCE_DSN'],
                        arguments: ['run', 'plan,extract,load,transform,package,verify,store', '--spec', 'datadouble/shop.yml', '--work', '/srv/datadouble/work', '--retry-key', (params.RETRY_KEY ?: env.BUILD_TAG)],
                    )
                }
            }
        }
    }
    post {
        failure {
            script {
                try {
                    mail(to: 'data-team@example.com, oncall@example.com', subject: 'Datadouble shop build: failure', body: 'Datadouble shop build: failure.' + (env.BUILD_URL ? ' The run: ' + env.BUILD_URL : ''))
                } catch (err) {
                    echo "notify's email could not be sent"
                }
            }
        }
        aborted {
            script {
                try {
                    mail(to: 'data-team@example.com, oncall@example.com', subject: 'Datadouble shop build: aborted', body: 'Datadouble shop build: aborted.' + (env.BUILD_URL ? ' The run: ' + env.BUILD_URL : ''))
                } catch (err) {
                    echo "notify's email could not be sent"
                }
            }
        }
        unstable {
            script {
                try {
                    mail(to: 'data-team@example.com, oncall@example.com', subject: 'Datadouble shop build: unstable', body: 'Datadouble shop build: unstable.' + (env.BUILD_URL ? ' The run: ' + env.BUILD_URL : ''))
                } catch (err) {
                    echo "notify's email could not be sent"
                }
            }
        }
    }
}
