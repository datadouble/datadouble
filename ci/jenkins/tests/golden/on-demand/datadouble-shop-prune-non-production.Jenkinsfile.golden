// Generated by `datadouble ci init` (Datadouble 1.2.3). Change the spec or
// the options and generate it again, rather than editing it by hand. Run it
// as the Pipeline job datadouble-shop-prune-non-production.

library(identifier: 'datadouble@v1.2.3', retriever: modernSCM(
    scm: [$class: 'GitSCMSource', remote: 'https://github.com/datadouble/datadouble.git'],
    libraryPath: 'ci/jenkins/'))

pipeline {
    agent { label 'staging && linux' }
    options {
        disableConcurrentBuilds()
        timeout(time: 60, unit: 'MINUTES')
    }
    parameters {
        booleanParam(name: 'DRY_RUN', defaultValue: false, description: 'Report what would be removed, without removing it')
    }
    triggers {
        cron('TZ=UTC\n0 4 * * *')
    }
    stages {
        stage('datadouble prune') {
            steps {
                withCredentials([string(credentialsId: 'ALERTS_WEBHOOK', variable: 'ALERTS_WEBHOOK')]) {
                    datadouble(
                        job: 'prune',
                        image: 'ghcr.io/datadouble/datadouble:v1.2.3',
                        user: '999:999',
                        mounts: ['/srv/datadouble/staging'],
                        environment: ['ALERTS_WEBHOOK'],
                        arguments: ['prune', '--ci-record', '/srv/datadouble/staging/.datadouble-notify/shop.prune.json', '--spec', 'datadouble/shop.yml', '--target', 'staging', (params.DRY_RUN ? '--dry-run' : '')],
                    )
                }
            }
        }
    }
    post {
        failure {
            script {
                try {
                    mail(to: 'data-team@example.com, oncall@example.com', subject: 'Datadouble shop prune: failure', body: 'Datadouble shop prune: failure.' + (env.BUILD_URL ? ' The run: ' + env.BUILD_URL : ''))
                } catch (err) {
                    echo "notify's email could not be sent"
                }
            }
        }
        aborted {
            script {
                try {
                    mail(to: 'data-team@example.com, oncall@example.com', subject: 'Datadouble shop prune: aborted', body: 'Datadouble shop prune: aborted.' + (env.BUILD_URL ? ' The run: ' + env.BUILD_URL : ''))
                } catch (err) {
                    echo "notify's email could not be sent"
                }
            }
        }
        unstable {
            script {
                try {
                    mail(to: 'data-team@example.com, oncall@example.com', subject: 'Datadouble shop prune: unstable', body: 'Datadouble shop prune: unstable.' + (env.BUILD_URL ? ' The run: ' + env.BUILD_URL : ''))
                } catch (err) {
                    echo "notify's email could not be sent"
                }
            }
        }
        fixed {
            script {
                try {
                    mail(to: 'data-team@example.com, oncall@example.com', subject: 'Datadouble shop prune: recovered', body: 'Datadouble shop prune: recovered.' + (env.BUILD_URL ? ' The run: ' + env.BUILD_URL : ''))
                } catch (err) {
                    echo "notify's email could not be sent"
                }
            }
        }
    }
}
