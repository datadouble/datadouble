// Generated by `datadouble ci init` (Datadouble 1.2.3). Change the spec or
// the options and generate it again, rather than editing it by hand. Run it
// as the Pipeline job datadouble-shop-fetch.

library(identifier: 'datadouble@v1.2.3', retriever: modernSCM(
    scm: [$class: 'GitSCMSource', remote: 'https://github.com/datadouble/datadouble.git'],
    libraryPath: 'ci/jenkins/'))

pipeline {
    agent { label 'staging && linux' }
    options {
        disableConcurrentBuilds()
        timeout(time: 60, unit: 'MINUTES')
    }
    triggers {
        cron('TZ=UTC\n*/15 * * * *')
    }
    stages {
        stage('datadouble fetch') {
            steps {
                withCredentials([string(credentialsId: 'ALERTS_WEBHOOK', variable: 'ALERTS_WEBHOOK'), string(credentialsId: 'SHOP_COSIGN_PUB', variable: 'SHOP_COSIGN_PUB')]) {
                    datadouble(
                        job: 'fetch',
                        image: 'ghcr.io/datadouble/datadouble:v1.2.3',
                        user: '999:999',
                        mounts: ['/srv/datadouble/staging'],
                        environment: ['ALERTS_WEBHOOK', 'SHOP_COSIGN_PUB'],
                        arguments: ['fetch', '--ci-record', '/srv/datadouble/staging/.datadouble-notify/shop.fetch.json', '--spec', 'datadouble/shop.yml'],
                    )
                }
            }
        }
    }
    post {
        failure {
            script {
                try {
                    mail(to: 'data-team@example.com, oncall@example.com', subject: 'Datadouble shop fetch: failure', body: 'Datadouble shop fetch: failure.' + (env.BUILD_URL ? ' The run: ' + env.BUILD_URL : ''))
                } catch (err) {
                    echo "notify's email could not be sent"
                }
            }
        }
        aborted {
            script {
                try {
                    mail(to: 'data-team@example.com, oncall@example.com', subject: 'Datadouble shop fetch: aborted', body: 'Datadouble shop fetch: aborted.' + (env.BUILD_URL ? ' The run: ' + env.BUILD_URL : ''))
                } catch (err) {
                    echo "notify's email could not be sent"
                }
            }
        }
        unstable {
            script {
                try {
                    mail(to: 'data-team@example.com, oncall@example.com', subject: 'Datadouble shop fetch: unstable', body: 'Datadouble shop fetch: unstable.' + (env.BUILD_URL ? ' The run: ' + env.BUILD_URL : ''))
                } catch (err) {
                    echo "notify's email could not be sent"
                }
            }
        }
        fixed {
            script {
                try {
                    mail(to: 'data-team@example.com, oncall@example.com', subject: 'Datadouble shop fetch: recovered', body: 'Datadouble shop fetch: recovered.' + (env.BUILD_URL ? ' The run: ' + env.BUILD_URL : ''))
                } catch (err) {
                    echo "notify's email could not be sent"
                }
            }
        }
    }
}
