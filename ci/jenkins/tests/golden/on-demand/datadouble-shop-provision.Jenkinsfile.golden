// Generated by `datadouble ci init` (Datadouble 1.2.3). Change the spec or
// the options and generate it again, rather than editing it by hand. Run it
// as the Pipeline job datadouble-shop-provision.

library(identifier: 'datadouble@v1.2.3', retriever: modernSCM(
    scm: [$class: 'GitSCMSource', remote: 'https://github.com/datadouble/datadouble.git'],
    libraryPath: 'ci/jenkins/'))

pipeline {
    agent { label 'staging && linux' }
    options {
        disableConcurrentBuilds()
        timeout(time: 60, unit: 'MINUTES')
    }
    parameters {
        string(name: 'OWNER', description: 'The request the copies are for, such as pr-7')
    }
    stages {
        stage('datadouble replicate') {
            steps {
                withCredentials([string(credentialsId: 'ALERTS_WEBHOOK', variable: 'ALERTS_WEBHOOK')]) {
                    datadouble(
                        job: 'provision',
                        image: 'ghcr.io/datadouble/datadouble:v1.2.3',
                        user: '999:999',
                        mounts: ['/srv/datadouble/staging'],
                        environment: ['ALERTS_WEBHOOK'],
                        arguments: ['replicate', '--spec', 'datadouble/shop.yml', '--owner', params.OWNER],
                    )
                }
            }
        }
    }
    post {
        failure {
            script {
                try {
                    mail(to: 'data-team@example.com, oncall@example.com', subject: 'Datadouble shop provision: failure', body: 'Datadouble shop provision: failure.' + (env.BUILD_URL ? ' The run: ' + env.BUILD_URL : ''))
                } catch (err) {
                    echo "notify's email could not be sent"
                }
            }
        }
        aborted {
            script {
                try {
                    mail(to: 'data-team@example.com, oncall@example.com', subject: 'Datadouble shop provision: aborted', body: 'Datadouble shop provision: aborted.' + (env.BUILD_URL ? ' The run: ' + env.BUILD_URL : ''))
                } catch (err) {
                    echo "notify's email could not be sent"
                }
            }
        }
        unstable {
            script {
                try {
                    mail(to: 'data-team@example.com, oncall@example.com', subject: 'Datadouble shop provision: unstable', body: 'Datadouble shop provision: unstable.' + (env.BUILD_URL ? ' The run: ' + env.BUILD_URL : ''))
                } catch (err) {
                    echo "notify's email could not be sent"
                }
            }
        }
    }
}
