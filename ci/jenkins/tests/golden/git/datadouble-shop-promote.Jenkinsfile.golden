// Generated by `datadouble ci init` (Datadouble 1.2.3). Change the spec or
// the options and generate it again, rather than editing it by hand. Run it
// as the Pipeline job datadouble-shop-promote.

library(identifier: 'datadouble@v1.2.3', retriever: modernSCM(
    scm: [$class: 'GitSCMSource', remote: 'https://github.com/datadouble/datadouble.git'],
    libraryPath: 'ci/jenkins/'))

pipeline {
    agent { label 'prod-db' }
    options {
        disableConcurrentBuilds()
        timeout(time: 60, unit: 'MINUTES')
    }
    triggers {
        upstream(upstreamProjects: 'datadouble-shop-build', threshold: hudson.model.Result.UNSTABLE)
    }
    stages {
        stage('spec') {
            steps {
                dir('.datadouble-spec') {
                    checkout scmGit(branches: [[name: 'main']], userRemoteConfigs: [[url: 'https://git.example.com/data/specs.git', credentialsId: 'specs-read']])
                }
            }
        }
        stage('datadouble promote') {
            steps {
                withCredentials([string(credentialsId: 'ALERTS_WEBHOOK', variable: 'ALERTS_WEBHOOK'), string(credentialsId: 'SHOP_COSIGN_PUB', variable: 'SHOP_COSIGN_PUB')]) {
                    datadouble(
                        job: 'promote',
                        image: 'ghcr.io/datadouble/datadouble:v1.2.3',
                        user: '999:999',
                        mounts: ['/srv/datadouble/store', '/srv/datadouble/work'],
                        environment: ['ALERTS_WEBHOOK', 'SHOP_COSIGN_PUB'],
                        arguments: ['promote', '--ci-record', '/srv/datadouble/work/.datadouble-notify/shop.promote.json', '--spec', '.datadouble-spec/datadouble/shop.yml'],
                    )
                }
            }
        }
    }
    post {
        failure {
            script {
                try {
                    mail(to: 'data-team@example.com, oncall@example.com', subject: 'Datadouble shop promote: failure', body: 'Datadouble shop promote: failure.' + (env.BUILD_URL ? ' The run: ' + env.BUILD_URL : ''))
                } catch (err) {
                    echo "notify's email could not be sent"
                }
            }
        }
        aborted {
            script {
                try {
                    mail(to: 'data-team@example.com, oncall@example.com', subject: 'Datadouble shop promote: aborted', body: 'Datadouble shop promote: aborted.' + (env.BUILD_URL ? ' The run: ' + env.BUILD_URL : ''))
                } catch (err) {
                    echo "notify's email could not be sent"
                }
            }
        }
        unstable {
            script {
                try {
                    mail(to: 'data-team@example.com, oncall@example.com', subject: 'Datadouble shop promote: unstable', body: 'Datadouble shop promote: unstable.' + (env.BUILD_URL ? ' The run: ' + env.BUILD_URL : ''))
                } catch (err) {
                    echo "notify's email could not be sent"
                }
            }
        }
        fixed {
            script {
                try {
                    mail(to: 'data-team@example.com, oncall@example.com', subject: 'Datadouble shop promote: recovered', body: 'Datadouble shop promote: recovered.' + (env.BUILD_URL ? ' The run: ' + env.BUILD_URL : ''))
                } catch (err) {
                    echo "notify's email could not be sent"
                }
            }
        }
    }
}
