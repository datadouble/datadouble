// Generated by `datadouble ci init` (Datadouble 1.2.3). Change the spec or
// the options and generate it again, rather than editing it by hand. Run it
// as the Pipeline job datadouble-shop-lock.

library(identifier: 'datadouble@v1.2.3', retriever: modernSCM(
    scm: [$class: 'GitSCMSource', remote: 'https://github.com/datadouble/datadouble.git'],
    libraryPath: 'ci/jenkins/'))

pipeline {
    agent { label 'prod-db' }
    options {
        disableConcurrentBuilds()
        timeout(time: 60, unit: 'MINUTES')
    }
    stages {
        stage('datadouble lock') {
            steps {
                withCredentials([string(credentialsId: 'ALERTS_WEBHOOK', variable: 'ALERTS_WEBHOOK'), string(credentialsId: 'SHOP_SOURCE_DSN', variable: 'SHOP_SOURCE_DSN')]) {
                    datadouble(
                        job: 'lock',
                        image: 'ghcr.io/datadouble/datadouble:v1.2.3',
                        user: '999:999',
                        mounts: ['/srv/datadouble/work'],
                        environment: ['ALERTS_WEBHOOK', 'SHOP_SOURCE_DSN'],
                        arguments: ['lock', '--ci-record', '/srv/datadouble/work/.datadouble-notify/shop.lock.json', '--spec', 'datadouble/shop.yml', '--output', 'datadouble-lock'],
                        artifacts: 'datadouble-lock',
                    )
                }
            }
        }
    }
    post {
        failure {
            script {
                try {
                    mail(to: 'data-team@example.com, oncall@example.com', subject: 'Datadouble shop lock: failure', body: 'Datadouble shop lock: failure.' + (env.BUILD_URL ? ' The run: ' + env.BUILD_URL : ''))
                } catch (err) {
                    echo "notify's email could not be sent"
                }
            }
        }
        aborted {
            script {
                try {
                    mail(to: 'data-team@example.com, oncall@example.com', subject: 'Datadouble shop lock: aborted', body: 'Datadouble shop lock: aborted.' + (env.BUILD_URL ? ' The run: ' + env.BUILD_URL : ''))
                } catch (err) {
                    echo "notify's email could not be sent"
                }
            }
        }
        unstable {
            script {
                try {
                    mail(to: 'data-team@example.com, oncall@example.com', subject: 'Datadouble shop lock: unstable', body: 'Datadouble shop lock: unstable.' + (env.BUILD_URL ? ' The run: ' + env.BUILD_URL : ''))
                } catch (err) {
                    echo "notify's email could not be sent"
                }
            }
        }
        fixed {
            script {
                try {
                    mail(to: 'data-team@example.com, oncall@example.com', subject: 'Datadouble shop lock: recovered', body: 'Datadouble shop lock: recovered.' + (env.BUILD_URL ? ' The run: ' + env.BUILD_URL : ''))
                } catch (err) {
                    echo "notify's email could not be sent"
                }
            }
        }
    }
}
