// Generated by `datadouble ci init` (Datadouble 1.2.3). Change the spec or
// the options and generate it again, rather than editing it by hand. Run it
// as the Pipeline job datadouble-shop-release.

library(identifier: 'datadouble@v1.2.3', retriever: modernSCM(
    scm: [$class: 'GitSCMSource', remote: 'https://github.com/datadouble/datadouble.git'],
    libraryPath: 'ci/jenkins/'))

pipeline {
    agent {
        kubernetes {
            namespace 'shop-staging'
            yaml '''
                apiVersion: v1
                kind: Pod
                spec:
                  serviceAccountName: datadouble-shop-non-production
                  containers:
                  - name: jnlp
                    command:
                    - /bin/sh
                    - -c
                    - umask 0000 && exec /usr/local/bin/jenkins-agent "$@"
                    - jenkins-agent
                  - name: datadouble
                    image: ghcr.io/datadouble/datadouble:v1.2.3
                    command:
                    - sleep
                    args:
                    - infinity
                    securityContext:
                      runAsUser: 999
                      runAsGroup: 999
                      runAsNonRoot: true
                      allowPrivilegeEscalation: false
                    volumeMounts:
                    - name: work
                      mountPath: /srv/datadouble
                    - name: boundary
                      mountPath: /etc/datadouble-boundary
                      readOnly: true
                  volumes:
                  - name: work
                    persistentVolumeClaim:
                      claimName: datadouble
                  - name: boundary
                    configMap:
                      name: datadouble-boundary
                      optional: true
                  nodeSelector:
                    kubernetes.io/hostname: worker-3
                '''
        }
    }
    options {
        disableConcurrentBuilds()
        timeout(time: 60, unit: 'MINUTES')
    }
    parameters {
        string(name: 'OWNER', description: 'The request the copies are for, such as pr-7')
    }
    triggers {
        cron('TZ=UTC\n30 3 * * *')
    }
    stages {
        stage('datadouble release 1') {
            when { expression { params.OWNER } }
            steps {
                withCredentials([string(credentialsId: 'ALERTS_WEBHOOK', variable: 'ALERTS_WEBHOOK')]) {
                    datadouble(
                        job: 'release',
                        container: 'datadouble',
                        environment: ['ALERTS_WEBHOOK'],
                        arguments: ['release', '--spec', 'datadouble/shop.yml', '--owner', params.OWNER],
                    )
                }
            }
        }
        stage('datadouble release 2') {
            when { expression { !params.OWNER } }
            steps {
                withCredentials([string(credentialsId: 'ALERTS_WEBHOOK', variable: 'ALERTS_WEBHOOK')]) {
                    datadouble(
                        job: 'release',
                        container: 'datadouble',
                        environment: ['ALERTS_WEBHOOK'],
                        arguments: ['release', '--spec', 'datadouble/shop.yml', '--expired'],
                    )
                }
            }
        }
    }
    post {
        failure {
            script {
                try {
                    mail(to: 'data-team@example.com, oncall@example.com', subject: 'Datadouble shop release: failure', body: 'Datadouble shop release: failure.' + (env.BUILD_URL ? ' The run: ' + env.BUILD_URL : ''))
                } catch (err) {
                    echo "notify's email could not be sent"
                }
            }
        }
        aborted {
            script {
                try {
                    mail(to: 'data-team@example.com, oncall@example.com', subject: 'Datadouble shop release: aborted', body: 'Datadouble shop release: aborted.' + (env.BUILD_URL ? ' The run: ' + env.BUILD_URL : ''))
                } catch (err) {
                    echo "notify's email could not be sent"
                }
            }
        }
        unstable {
            script {
                try {
                    mail(to: 'data-team@example.com, oncall@example.com', subject: 'Datadouble shop release: unstable', body: 'Datadouble shop release: unstable.' + (env.BUILD_URL ? ' The run: ' + env.BUILD_URL : ''))
                } catch (err) {
                    echo "notify's email could not be sent"
                }
            }
        }
    }
}
