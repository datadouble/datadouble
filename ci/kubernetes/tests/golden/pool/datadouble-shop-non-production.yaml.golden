# Generated by `datadouble ci init` (Datadouble 1.2.3). Change the spec or
# the options and generate it again, rather than editing it by hand: the spec
# and its catalog lock are copied into the values below.
apiVersion: argoproj.io/v1alpha1
kind: Application
metadata:
  name: datadouble-shop-non-production
  namespace: argocd
spec:
  project: default
  destination:
    server: https://kubernetes.default.svc
    namespace: shop
  source:
    repoURL: https://github.com/datadouble/datadouble.git
    targetRevision: v1.2.3
    path: ci/kubernetes/chart
    helm:
      releaseName: shop-non-production
      valuesObject:
        name: datadouble-shop-non-production
        image: ghcr.io/datadouble/datadouble:v1.2.3
        user:
          uid: 999
          gid: 999
        spec:
          path: datadouble/shop.yml
          files:
            shop.yml: |2

              name: shop
              sources:
                app:
                  engine: postgres
                  connection:
                    dsn:
                      env: SHOP_SOURCE_DSN
              runtime:
                kubernetes:
                  claim: datadouble
                  mount: /srv/datadouble
              store:
                - filesystem:
                    path: /srv/datadouble/store
              signing:
                cosign:
                  key:
                    env: SHOP_COSIGN_KEY
              trust:
                cosign:
                  public_key:
                    env: SHOP_COSIGN_PUB
              promote:
                to:
                  - filesystem:
                      path: /srv/datadouble/export
              fetch:
                from:
                  filesystem:
                    path: /srv/datadouble/export
                staging: /srv/datadouble/staging
              notify:
                when: [failure, warning]
                to:
                  - webhook:
                      url:
                        env: ALERTS_WEBHOOK
              replicate:
                using:
                  k8s-pv:
                    path: /srv/datadouble/copies
                mode: pool
                size: 1
          lock: |
            {}
        claim:
          name: datadouble
          mount: /srv/datadouble
        secret: datadouble-shop
        persistentVolumes: true
        jobs:
        - name: fetch
          schedule: '*/15 * * * *'
          timeoutMinutes: 120
          steps:
          - job: fetch
            arguments:
            - fetch
            - --spec
            - datadouble/shop.yml
            environment:
            - ALERTS_WEBHOOK
            - SHOP_COSIGN_PUB
          - &id001
            job: provision
            arguments:
            - replicate
            - --spec
            - datadouble/shop.yml
            environment:
            - ALERTS_WEBHOOK
        - name: provision
          schedule: 0 * * * *
          timeoutMinutes: 60
          steps:
          - *id001
        - name: release
          schedule: 30 3 * * *
          timeoutMinutes: 60
          steps:
          - job: release
            arguments:
            - release
            - --spec
            - datadouble/shop.yml
            - --expired
            environment:
            - ALERTS_WEBHOOK
  syncPolicy:
    automated:
      prune: true
      selfHeal: true
