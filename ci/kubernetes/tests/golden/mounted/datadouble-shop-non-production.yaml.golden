# Generated by `datadouble ci init` (Datadouble 1.2.3). Change the spec or
# the options and generate it again, rather than editing it by hand: the spec
# and its catalog lock are copied into the values below.
apiVersion: argoproj.io/v1alpha1
kind: Application
metadata:
  name: datadouble-shop-non-production
  namespace: argocd
spec:
  project: default
  destination:
    server: https://kubernetes.default.svc
    namespace: shop
  source:
    repoURL: https://github.com/datadouble/datadouble.git
    targetRevision: v1.2.3
    path: ci/kubernetes/chart
    helm:
      releaseName: shop-non-production
      valuesObject:
        name: datadouble-shop-non-production
        image: ghcr.io/datadouble/datadouble:v1.2.3
        user:
          uid: 999
          gid: 999
        spec:
          path: /etc/datadouble-spec/shop.yml
          configMap: shop-spec
        claim:
          name: datadouble
          mount: /srv/datadouble
        secret: datadouble-shop
        persistentVolumes: true
        jobs:
        - name: fetch
          schedule: '*/15 * * * *'
          timeoutMinutes: 60
          steps:
          - job: fetch
            arguments:
            - fetch
            - --spec
            - /etc/datadouble-spec/shop.yml
            environment:
            - ALERTS_WEBHOOK
            - SHOP_COSIGN_PUB
        - name: release
          schedule: 30 3 * * *
          timeoutMinutes: 60
          steps:
          - job: release
            arguments:
            - release
            - --spec
            - /etc/datadouble-spec/shop.yml
            - --expired
            environment:
            - ALERTS_WEBHOOK
        - name: prune-non-production
          schedule: 0 4 * * *
          timeoutMinutes: 60
          steps:
          - job: prune
            arguments:
            - prune
            - --spec
            - /etc/datadouble-spec/shop.yml
            - --target
            - staging
            - $(DATADOUBLE_DRY_RUN)
            environment:
            - ALERTS_WEBHOOK
        - name: activate
          schedule: ''
          timeoutMinutes: 60
          steps:
          - job: activate
            arguments:
            - activate
            - $(DATADOUBLE_GENERATION)
            - --spec
            - /etc/datadouble-spec/shop.yml
            environment:
            - ALERTS_WEBHOOK
        - name: request-copies
          hook: PreSync
          timeoutMinutes: 60
          steps:
          - job: provision
            arguments:
            - replicate
            - --spec
            - /etc/datadouble-spec/shop.yml
            - --owner
            - $(DATADOUBLE_OWNER)
            environment:
            - ALERTS_WEBHOOK
        - name: request-release
          hook: PostDelete
          timeoutMinutes: 60
          steps:
          - job: release
            arguments:
            - release
            - --spec
            - /etc/datadouble-spec/shop.yml
            - --owner
            - $(DATADOUBLE_OWNER)
            environment:
            - ALERTS_WEBHOOK
  syncPolicy:
    automated:
      prune: true
      selfHeal: true
