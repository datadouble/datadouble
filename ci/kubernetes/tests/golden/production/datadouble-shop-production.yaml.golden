# Generated by `datadouble ci init` (Datadouble 1.2.3). Change the spec or
# the options and generate it again, rather than editing it by hand: the spec
# and its catalog lock are copied into the values below.
apiVersion: argoproj.io/v1alpha1
kind: Application
metadata:
  name: datadouble-shop-production
  namespace: argocd
spec:
  project: default
  destination:
    server: https://kubernetes.default.svc
    namespace: shop
  source:
    repoURL: https://github.com/datadouble/datadouble.git
    targetRevision: v1.2.3
    path: ci/kubernetes/chart
    helm:
      releaseName: shop-production
      valuesObject:
        name: datadouble-shop-production
        image: ghcr.io/datadouble/datadouble:v1.2.3
        user:
          uid: 999
          gid: 999
        spec:
          path: datadouble/shop.yml
          content: |2

            name: shop
            source:
              engine: postgres
              connection:
                dsn:
                  env: SHOP_SOURCE_DSN
            runtime:
              kubernetes:
                claim: datadouble
                mount: /srv/datadouble
            store:
              - filesystem:
                  path: /srv/datadouble/store
            signing:
              cosign:
                key:
                  env: SHOP_COSIGN_KEY
            trust:
              cosign:
                public_key:
                  env: SHOP_COSIGN_PUB
            promote:
              to:
                - filesystem:
                    path: /srv/datadouble/export
            fetch:
              from:
                filesystem:
                  path: /srv/datadouble/export
              staging: /srv/datadouble/staging
            notify:
              when: [failure, warning]
              to:
                - webhook:
                    url:
                      env: ALERTS_WEBHOOK
            replicate:
              using:
                k8s-pv:
                  path: /srv/datadouble/copies
              mode: on-demand
              size: 1
          lock: |
            {}
        claim:
          name: datadouble
          mount: /srv/datadouble
        secret: datadouble-shop
        persistentVolumes: false
        jobs:
        - name: build
          schedule: 0 2 * * 1
          timeoutMinutes: 780
          steps:
          - job: build
            arguments:
            - run
            - plan,extract,load,transform,package,verify,store
            - --spec
            - datadouble/shop.yml
            - --work
            - /srv/datadouble/work
            - --retry-key
            - $(DATADOUBLE_RUN)
            environment:
            - ALERTS_WEBHOOK
            - COSIGN_PASSWORD
            - SHOP_COSIGN_KEY
            - SHOP_SOURCE_DSN
          - &id001
            job: promote
            arguments:
            - promote
            - --spec
            - datadouble/shop.yml
            environment:
            - ALERTS_WEBHOOK
            - SHOP_COSIGN_PUB
        - name: promote
          schedule: ''
          timeoutMinutes: 60
          steps:
          - *id001
        - name: prune-production
          schedule: 0 4 * * *
          timeoutMinutes: 60
          steps:
          - job: prune
            arguments:
            - prune
            - --spec
            - datadouble/shop.yml
            - --target
            - store
            - $(DATADOUBLE_DRY_RUN)
            environment:
            - ALERTS_WEBHOOK
          - job: prune
            arguments:
            - prune
            - --spec
            - datadouble/shop.yml
            - --target
            - export
            - $(DATADOUBLE_DRY_RUN)
            environment:
            - ALERTS_WEBHOOK
        - name: lock
          schedule: ''
          timeoutMinutes: 60
          artifacts: datadouble-lock
          steps:
          - job: lock
            arguments:
            - lock
            - --spec
            - datadouble/shop.yml
            - --output
            - datadouble-lock
            environment:
            - ALERTS_WEBHOOK
            - SHOP_SOURCE_DSN
  syncPolicy:
    automated:
      prune: true
      selfHeal: true
