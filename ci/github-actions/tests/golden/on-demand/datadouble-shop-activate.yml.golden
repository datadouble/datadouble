# Generated by `datadouble ci init` (Datadouble 1.2.3). Change the spec or
# the options and generate it again, rather than editing it by hand.
name: Datadouble shop activate
on:
  workflow_dispatch:
    inputs:
      generation:
        description: The staged generation to activate
        required: true
        type: string
permissions:
  contents: read
concurrency:
  group: datadouble-shop-activate
  cancel-in-progress: false
jobs:
  activate:
    name: activate
    runs-on:
      - self-hosted
      - staging
      - linux
    timeout-minutes: 60
    steps:
      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1
        with:
          persist-credentials: false
      - name: datadouble activate
        uses: datadouble/datadouble/ci/github-actions@v1.2.3
        env:
          ALERTS_WEBHOOK: ${{ secrets.ALERTS_WEBHOOK }}
        with:
          job: activate
          image: ghcr.io/datadouble/datadouble:v1.2.3
          user: 999:999
          mounts: |
            /srv/datadouble/staging
          environment: |
            ALERTS_WEBHOOK
          arguments: |
            activate
            ${{ inputs.generation }}
            --spec
            datadouble/shop.yml
