# Generated by `datadouble ci init` (Datadouble 1.2.3). Change the spec or
# the options and generate it again, rather than editing it by hand.
name: Datadouble shop prune-non-production
on:
  schedule:
    - cron: 0 4 * * *
  workflow_dispatch:
    inputs:
      dry-run:
        description: Report what would be removed, without removing it
        required: false
        type: boolean
        default: false
permissions:
  contents: read
concurrency:
  group: datadouble-shop-prune-non-production
  cancel-in-progress: false
jobs:
  prune:
    name: prune
    runs-on:
      - self-hosted
      - staging
      - linux
    timeout-minutes: 60
    steps:
      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1
        with:
          persist-credentials: false
      - name: datadouble prune
        uses: datadouble/datadouble/ci/github-actions@v1.2.3
        env:
          ALERTS_WEBHOOK: ${{ secrets.ALERTS_WEBHOOK }}
        with:
          job: prune
          image: ghcr.io/datadouble/datadouble:v1.2.3
          user: 999:999
          mounts: |
            /srv/datadouble/staging
          environment: |
            ALERTS_WEBHOOK
          arguments: |
            prune
            --spec
            datadouble/shop.yml
            --target
            staging
            ${{ inputs.dry-run && '--dry-run' || '' }}
