# Generated by `datadouble ci init` (Datadouble 1.2.3). Change the spec or
# the options and generate it again, rather than editing it by hand.
name: Datadouble shop release
on:
  schedule:
    - cron: 30 3 * * *
  pull_request:
    types:
      - closed
  workflow_dispatch:
permissions:
  contents: read
concurrency:
  group: datadouble-shop-release-${{ github.event.pull_request.number || 'scheduled' }}
  cancel-in-progress: false
jobs:
  release:
    name: release
    runs-on:
      - self-hosted
      - staging
      - linux
    if: (github.event_name != 'pull_request' || github.event.pull_request.head.repo.full_name == github.repository)
    timeout-minutes: 60
    steps:
      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1
        with:
          persist-credentials: false
      - name: datadouble release
        if: github.event_name == 'pull_request'
        uses: datadouble/datadouble/ci/github-actions@v1.2.3
        with:
          image: ghcr.io/datadouble/datadouble:v1.2.3
          user: 999:999
          mounts: |
            /srv/datadouble/staging
          arguments: |
            release
            --spec
            datadouble/shop.yml
            --owner
            pr-${{ github.event.pull_request.number }}
      - name: datadouble release
        if: github.event_name == 'schedule' || github.event_name == 'workflow_dispatch'
        uses: datadouble/datadouble/ci/github-actions@v1.2.3
        with:
          image: ghcr.io/datadouble/datadouble:v1.2.3
          user: 999:999
          mounts: |
            /srv/datadouble/staging
          arguments: |
            release
            --spec
            datadouble/shop.yml
            --expired
