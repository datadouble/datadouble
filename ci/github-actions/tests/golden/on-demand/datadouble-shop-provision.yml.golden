# Generated by `datadouble ci init` (Datadouble 1.2.3). Change the spec or
# the options and generate it again, rather than editing it by hand.
name: Datadouble shop provision
on:
  pull_request:
    types:
      - opened
      - reopened
permissions:
  contents: read
concurrency:
  group: datadouble-shop-provision-${{ github.event.pull_request.number || 'scheduled' }}
  cancel-in-progress: false
jobs:
  provision:
    name: provision
    runs-on:
      - self-hosted
      - staging
      - linux
    if: (github.event_name != 'pull_request' || github.event.pull_request.head.repo.full_name == github.repository)
    timeout-minutes: 60
    steps:
      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1
        with:
          persist-credentials: false
      - name: datadouble replicate
        uses: datadouble/datadouble/ci/github-actions@v1.2.3
        env:
          ALERTS_WEBHOOK: ${{ secrets.ALERTS_WEBHOOK }}
        with:
          job: provision
          image: ghcr.io/datadouble/datadouble:v1.2.3
          user: 999:999
          mounts: |
            /srv/datadouble/staging
          environment: |
            ALERTS_WEBHOOK
          arguments: |
            replicate
            --spec
            datadouble/shop.yml
            --owner
            pr-${{ github.event.pull_request.number }}
