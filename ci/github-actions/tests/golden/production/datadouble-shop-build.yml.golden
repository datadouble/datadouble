# Generated by `datadouble ci init` (Datadouble 1.2.3). Change the spec or
# the options and generate it again, rather than editing it by hand.
name: Datadouble shop build
on:
  schedule:
    - cron: 0 2 * * 1
  workflow_dispatch:
permissions:
  contents: read
  id-token: write
concurrency:
  group: datadouble-shop-build
  cancel-in-progress: false
jobs:
  build:
    name: build
    runs-on:
      - self-hosted
      - prod-db
    timeout-minutes: 720
    steps:
      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1
        with:
          persist-credentials: false
      - name: datadouble run
        uses: datadouble/datadouble/ci/github-actions@v1.2.3
        env:
          SHOP_ANONYMIZATION_KEY: ${{ secrets.SHOP_ANONYMIZATION_KEY }}
          SHOP_SOURCE_DSN: ${{ secrets.SHOP_SOURCE_DSN }}
        with:
          image: ghcr.io/datadouble/datadouble:v1.2.3
          user: 999:999
          mounts: |
            /srv/datadouble/store
            /srv/datadouble/work
          environment: |
            SHOP_ANONYMIZATION_KEY
            SHOP_SOURCE_DSN
          arguments: |
            run
            plan,extract,load,transform,package,verify,store
            --spec
            datadouble/shop.yml
            --work
            /srv/datadouble/work
            --retry-key
            ${{ github.run_id }}
