# Generated by `datadouble ci init` (Datadouble 1.2.3). Change the spec or
# the options and generate it again, rather than editing it by hand.
name: Datadouble shop lock
on:
  workflow_dispatch:
permissions:
  contents: read
concurrency:
  group: datadouble-shop-lock
  cancel-in-progress: false
jobs:
  lock:
    name: lock
    runs-on:
      - self-hosted
      - prod-db
    timeout-minutes: 60
    steps:
      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1
        with:
          persist-credentials: false
      - name: datadouble lock
        uses: datadouble/datadouble/ci/github-actions@v1.2.3
        env:
          ALERTS_WEBHOOK: ${{ secrets.ALERTS_WEBHOOK }}
          SHOP_SOURCE_DSN: ${{ secrets.SHOP_SOURCE_DSN }}
        with:
          job: lock
          image: ghcr.io/datadouble/datadouble:v1.2.3
          user: 999:999
          environment: |
            ALERTS_WEBHOOK
            SHOP_SOURCE_DSN
          artifacts: datadouble-lock
          arguments: |
            lock
            --spec
            datadouble/shop.yml
            --output
            datadouble-lock
      - name: publish datadouble-lock
        uses: actions/upload-artifact@ea165f8d65b6e75b540449e92b4886f43607fa02 # v4.6.2
        with:
          name: datadouble-shop-lock
          path: datadouble-lock/
          if-no-files-found: error
