# Generated by `datadouble ci init` (Datadouble 1.2.3). Change the spec or
# the options and generate it again, rather than editing it by hand.
name: Datadouble shop provision
on:
  schedule:
    - cron: 0 * * * *
  workflow_run:
    workflows:
      - Datadouble shop fetch
    types:
      - completed
  workflow_dispatch:
permissions:
  contents: read
concurrency:
  group: datadouble-shop-provision
  cancel-in-progress: false
jobs:
  provision:
    name: provision
    runs-on: self-hosted
    if: (github.event_name != 'workflow_run' || github.event.workflow_run.conclusion == 'success')
    timeout-minutes: 60
    steps:
      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1
        with:
          persist-credentials: false
      - name: datadouble replicate
        uses: datadouble/datadouble/ci/github-actions@v1.2.3
        with:
          image: ghcr.io/datadouble/datadouble:v1.2.3
          user: 999:999
          mounts: |
            /srv/datadouble/staging
          arguments: |
            replicate
            --spec
            datadouble/shop.yml
