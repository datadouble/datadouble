# Generated by `datadouble ci init` (Datadouble 1.2.3). Change the spec or
# the options and generate it again, rather than editing it by hand. Include
# it from .gitlab-ci.yml:
#
#   include:
#     - local: .gitlab/datadouble-shop-non-production.yml
include:
- remote: https://raw.githubusercontent.com/datadouble/datadouble/v1.2.3/ci/gitlab/src/datadouble_gitlab/datadouble.yml
  integrity: sha256-gvFSahh6oPkFhDzL3iAAwYGo3d27vGGRcuNYzDZUBng=
variables:
  DATADOUBLE_JOB:
    value: ''
    description: 'The Datadouble job to run: shop-fetch, shop-provision, shop-release'
datadouble-shop-fetch:
  extends: .datadouble
  tags:
  - staging
  resource_group: datadouble-shop-fetch
  timeout: 60m
  rules:
  - if: $DATADOUBLE_JOB == "shop-fetch" && $CI_PIPELINE_SOURCE =~ /^(api|schedule|trigger|web)$/
  variables:
    DATADOUBLE_IMAGE: ghcr.io/datadouble/datadouble:v1.2.3
    DATADOUBLE_USER: 999:999
    DATADOUBLE_MOUNTS: |
      /srv/datadouble/staging
    DATADOUBLE_ENVIRONMENT: |
      SHOP_COSIGN_PUB
    DATADOUBLE_ARGUMENTS: |
      fetch
      --spec
      datadouble/shop.yml
datadouble-shop-provision:
  extends: .datadouble
  tags:
  - staging
  resource_group: datadouble-shop-provision
  timeout: 60m
  rules:
  - if: $DATADOUBLE_JOB == "shop-provision" && $CI_PIPELINE_SOURCE =~ /^(api|schedule|trigger|web)$/
  - if: $DATADOUBLE_JOB == "shop-fetch" && $CI_PIPELINE_SOURCE =~ /^(schedule|web|api|trigger)$/
  needs:
  - job: datadouble-shop-fetch
    optional: true
  variables:
    DATADOUBLE_IMAGE: ghcr.io/datadouble/datadouble:v1.2.3
    DATADOUBLE_USER: 999:999
    DATADOUBLE_MOUNTS: |
      /srv/datadouble/staging
    DATADOUBLE_ARGUMENTS: |
      replicate
      --spec
      datadouble/shop.yml
datadouble-shop-release:
  extends: .datadouble
  tags:
  - staging
  resource_group: datadouble-shop-release
  timeout: 60m
  rules:
  - if: $DATADOUBLE_JOB == "shop-release" && $CI_PIPELINE_SOURCE =~ /^(api|schedule|trigger|web)$/
  variables:
    DATADOUBLE_IMAGE: ghcr.io/datadouble/datadouble:v1.2.3
    DATADOUBLE_USER: 999:999
    DATADOUBLE_MOUNTS: |
      /srv/datadouble/staging
    DATADOUBLE_ARGUMENTS: |
      release
      --spec
      datadouble/shop.yml
      --expired
