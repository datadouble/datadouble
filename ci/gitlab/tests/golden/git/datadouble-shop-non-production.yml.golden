# Generated by `datadouble ci init` (Datadouble 1.2.3). Change the spec or
# the options and generate it again, rather than editing it by hand. Include
# it from .gitlab-ci.yml:
#
#   include:
#     - local: .gitlab/datadouble-shop-non-production.yml
include:
- remote: https://raw.githubusercontent.com/datadouble/datadouble/v1.2.3/ci/gitlab/src/datadouble_gitlab/datadouble.yml
  integrity: sha256-LHJTfir5cKBlkJjpGnIdSwBH+0lDgi0zWWMPZBGEPpU=
variables:
  DATADOUBLE_JOB:
    value: ''
    description: 'The Datadouble job to run: shop-provision, shop-release'
datadouble-shop-provision:
  extends: .datadouble
  tags:
  - staging
  resource_group: datadouble-shop-provision
  timeout: 60m
  rules:
  - if: $CI_PIPELINE_SOURCE == "merge_request_event" && $CI_MERGE_REQUEST_SOURCE_PROJECT_ID == $CI_PROJECT_ID
  environment:
    name: datadouble/shop/mr-$CI_MERGE_REQUEST_IID
    on_stop: datadouble-shop-release-1
  variables:
    DATADOUBLE_CI_JOB: provision
    DATADOUBLE_IMAGE: ghcr.io/datadouble/datadouble:v1.2.3
    DATADOUBLE_USER: 999:999
    DATADOUBLE_MOUNTS: |
      /srv/datadouble/staging
    DATADOUBLE_ENVIRONMENT: |
      ALERTS_WEBHOOK
    DATADOUBLE_ARGUMENTS: |
      replicate
      --spec
      .datadouble-spec/datadouble/shop.yml
      --owner
      mr-$CI_MERGE_REQUEST_IID
  before_script:
  - |
    set -euo pipefail
    rm -rf .datadouble-spec
    git init --quiet .datadouble-spec
    git -C .datadouble-spec -c credential.helper= -c 'credential.https://gitlab.example.com.helper=!f() { if [ "$1" = get ]; then echo username=oauth2; echo "password=$SPECS_TOKEN"; fi; }; f' fetch --quiet --depth 1 -- https://gitlab.example.com/data/specs.git main
    git -C .datadouble-spec checkout --quiet FETCH_HEAD
datadouble-shop-release-1:
  extends: .datadouble
  tags:
  - staging
  resource_group: datadouble-shop-release
  timeout: 60m
  rules:
  - if: $CI_PIPELINE_SOURCE == "merge_request_event" && $CI_MERGE_REQUEST_SOURCE_PROJECT_ID == $CI_PROJECT_ID
    when: manual
    allow_failure: true
  environment:
    name: datadouble/shop/mr-$CI_MERGE_REQUEST_IID
    action: stop
  variables:
    DATADOUBLE_CI_JOB: release
    DATADOUBLE_IMAGE: ghcr.io/datadouble/datadouble:v1.2.3
    DATADOUBLE_USER: 999:999
    DATADOUBLE_MOUNTS: |
      /srv/datadouble/staging
    DATADOUBLE_ENVIRONMENT: |
      ALERTS_WEBHOOK
    DATADOUBLE_ARGUMENTS: |
      release
      --spec
      .datadouble-spec/datadouble/shop.yml
      --owner
      mr-$CI_MERGE_REQUEST_IID
  before_script:
  - |
    set -euo pipefail
    rm -rf .datadouble-spec
    git init --quiet .datadouble-spec
    git -C .datadouble-spec -c credential.helper= -c 'credential.https://gitlab.example.com.helper=!f() { if [ "$1" = get ]; then echo username=oauth2; echo "password=$SPECS_TOKEN"; fi; }; f' fetch --quiet --depth 1 -- https://gitlab.example.com/data/specs.git main
    git -C .datadouble-spec checkout --quiet FETCH_HEAD
datadouble-shop-release-2:
  extends: .datadouble
  tags:
  - staging
  resource_group: datadouble-shop-release
  timeout: 60m
  rules:
  - if: $DATADOUBLE_JOB == "shop-release" && $CI_PIPELINE_SOURCE =~ /^(api|schedule|trigger|web)$/
  variables:
    DATADOUBLE_CI_JOB: release
    DATADOUBLE_IMAGE: ghcr.io/datadouble/datadouble:v1.2.3
    DATADOUBLE_USER: 999:999
    DATADOUBLE_MOUNTS: |
      /srv/datadouble/staging
    DATADOUBLE_ENVIRONMENT: |
      ALERTS_WEBHOOK
    DATADOUBLE_ARGUMENTS: |
      release
      --spec
      .datadouble-spec/datadouble/shop.yml
      --expired
  before_script:
  - |
    set -euo pipefail
    rm -rf .datadouble-spec
    git init --quiet .datadouble-spec
    git -C .datadouble-spec -c credential.helper= -c 'credential.https://gitlab.example.com.helper=!f() { if [ "$1" = get ]; then echo username=oauth2; echo "password=$SPECS_TOKEN"; fi; }; f' fetch --quiet --depth 1 -- https://gitlab.example.com/data/specs.git main
    git -C .datadouble-spec checkout --quiet FETCH_HEAD
