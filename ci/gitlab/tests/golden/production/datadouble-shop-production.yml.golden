# Generated by `datadouble ci init` (Datadouble 1.2.3). Change the spec or
# the options and generate it again, rather than editing it by hand. Include
# it from .gitlab-ci.yml:
#
#   include:
#     - local: .gitlab/datadouble-shop-production.yml
include:
- remote: https://raw.githubusercontent.com/datadouble/datadouble/v1.2.3/ci/gitlab/src/datadouble_gitlab/datadouble.yml
  integrity: sha256-jWpVraU1uN7RLgI2/UEYBcklIH5315ITpmt4Nt9/AUw=
variables:
  DATADOUBLE_JOB:
    value: ''
    description: 'The Datadouble job to run: shop-build, shop-promote, shop-prune-production, shop-lock'
  DATADOUBLE_DRY_RUN:
    value: ''
    options:
    - ''
    - --dry-run
    description: --dry-run reports what prune would remove, without removing it
datadouble-shop-build:
  extends: .datadouble
  tags:
  - prod-db
  resource_group: datadouble-shop-build
  timeout: 720m
  rules:
  - if: $DATADOUBLE_JOB == "shop-build" && $CI_PIPELINE_SOURCE =~ /^(api|schedule|trigger|web)$/
  variables:
    DATADOUBLE_CI_JOB: build
    DATADOUBLE_IMAGE: ghcr.io/datadouble/datadouble:v1.2.3
    DATADOUBLE_USER: 999:999
    DATADOUBLE_MOUNTS: |
      /srv/datadouble/store
      /srv/datadouble/work
    DATADOUBLE_ENVIRONMENT: |
      ALERTS_WEBHOOK
      COSIGN_PASSWORD
      SHOP_ANONYMIZATION_KEY
      SHOP_COSIGN_KEY
      SHOP_SOURCE_DSN
    DATADOUBLE_ARGUMENTS: |
      run
      plan,extract,load,transform,package,verify,store
      --spec
      datadouble/shop.yml
      --work
      /srv/datadouble/work
      --retry-key
      $CI_PIPELINE_ID
datadouble-shop-promote:
  extends: .datadouble
  tags:
  - prod-db
  resource_group: datadouble-shop-promote
  timeout: 60m
  rules:
  - if: $DATADOUBLE_JOB == "shop-promote" && $CI_PIPELINE_SOURCE =~ /^(api|trigger|web)$/
  - if: $DATADOUBLE_JOB == "shop-build" && $CI_PIPELINE_SOURCE =~ /^(schedule|web|api|trigger)$/
  needs:
  - job: datadouble-shop-build
    optional: true
  variables:
    DATADOUBLE_CI_JOB: promote
    DATADOUBLE_IMAGE: ghcr.io/datadouble/datadouble:v1.2.3
    DATADOUBLE_USER: 999:999
    DATADOUBLE_MOUNTS: |
      /srv/datadouble/store
    DATADOUBLE_ENVIRONMENT: |
      ALERTS_WEBHOOK
      SHOP_COSIGN_PUB
    DATADOUBLE_ARGUMENTS: |
      promote
      --spec
      datadouble/shop.yml
datadouble-shop-prune-production-1:
  extends: .datadouble
  tags:
  - prod-db
  resource_group: datadouble-shop-prune-production
  timeout: 60m
  rules:
  - if: $DATADOUBLE_JOB == "shop-prune-production" && $CI_PIPELINE_SOURCE =~ /^(api|schedule|trigger|web)$/
  variables:
    DATADOUBLE_CI_JOB: prune
    DATADOUBLE_IMAGE: ghcr.io/datadouble/datadouble:v1.2.3
    DATADOUBLE_USER: 999:999
    DATADOUBLE_MOUNTS: |
      /srv/datadouble/store
    DATADOUBLE_ENVIRONMENT: |
      ALERTS_WEBHOOK
    DATADOUBLE_ARGUMENTS: |
      prune
      --spec
      datadouble/shop.yml
      --target
      store
      $DATADOUBLE_DRY_RUN
datadouble-shop-prune-production-2:
  extends: .datadouble
  tags:
  - prod-db
  resource_group: datadouble-shop-prune-production
  timeout: 60m
  rules:
  - if: $DATADOUBLE_JOB == "shop-prune-production" && $CI_PIPELINE_SOURCE =~ /^(api|schedule|trigger|web)$/
  variables:
    DATADOUBLE_CI_JOB: prune
    DATADOUBLE_IMAGE: ghcr.io/datadouble/datadouble:v1.2.3
    DATADOUBLE_USER: 999:999
    DATADOUBLE_MOUNTS: |
      /srv/datadouble/store
    DATADOUBLE_ENVIRONMENT: |
      ALERTS_WEBHOOK
    DATADOUBLE_ARGUMENTS: |
      prune
      --spec
      datadouble/shop.yml
      --target
      export
      $DATADOUBLE_DRY_RUN
datadouble-shop-lock:
  extends: .datadouble
  tags:
  - prod-db
  resource_group: datadouble-shop-lock
  timeout: 60m
  rules:
  - if: $DATADOUBLE_JOB == "shop-lock" && $CI_PIPELINE_SOURCE =~ /^(api|trigger|web)$/
  artifacts:
    paths:
    - datadouble.env
    - datadouble-lock/
  variables:
    DATADOUBLE_CI_JOB: lock
    DATADOUBLE_IMAGE: ghcr.io/datadouble/datadouble:v1.2.3
    DATADOUBLE_USER: 999:999
    DATADOUBLE_ENVIRONMENT: |
      ALERTS_WEBHOOK
      SHOP_SOURCE_DSN
    DATADOUBLE_ARTIFACTS: datadouble-lock
    DATADOUBLE_ARGUMENTS: |
      lock
      --spec
      datadouble/shop.yml
      --output
      datadouble-lock
