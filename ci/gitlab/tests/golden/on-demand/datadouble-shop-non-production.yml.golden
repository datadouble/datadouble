# Generated by `datadouble ci init` (Datadouble 1.2.3). Change the spec or
# the options and generate it again, rather than editing it by hand. Include
# it from .gitlab-ci.yml:
#
#   include:
#     - local: .gitlab/datadouble-shop-non-production.yml
include:
- remote: https://raw.githubusercontent.com/datadouble/datadouble/v1.2.3/ci/gitlab/src/datadouble_gitlab/datadouble.yml
  integrity: sha256-jWpVraU1uN7RLgI2/UEYBcklIH5315ITpmt4Nt9/AUw=
variables:
  DATADOUBLE_JOB:
    value: ''
    description: 'The Datadouble job to run: shop-fetch, shop-provision, shop-release, shop-prune-non-production,
      shop-activate'
  DATADOUBLE_GENERATION:
    value: ''
    description: The staged generation to activate
  DATADOUBLE_DRY_RUN:
    value: ''
    options:
    - ''
    - --dry-run
    description: --dry-run reports what prune would remove, without removing it
datadouble-shop-fetch:
  extends: .datadouble
  tags:
  - staging
  - linux
  resource_group: datadouble-shop-fetch
  timeout: 60m
  rules:
  - if: $DATADOUBLE_JOB == "shop-fetch" && $CI_PIPELINE_SOURCE =~ /^(api|schedule|trigger|web)$/
  variables:
    DATADOUBLE_CI_JOB: fetch
    DATADOUBLE_IMAGE: ghcr.io/datadouble/datadouble:v1.2.3
    DATADOUBLE_USER: 999:999
    DATADOUBLE_MOUNTS: |
      /srv/datadouble/staging
    DATADOUBLE_ENVIRONMENT: |
      ALERTS_WEBHOOK
      SHOP_COSIGN_PUB
    DATADOUBLE_ARGUMENTS: |
      fetch
      --spec
      datadouble/shop.yml
datadouble-shop-provision:
  extends: .datadouble
  tags:
  - staging
  - linux
  resource_group: datadouble-shop-provision
  timeout: 60m
  rules:
  - if: $CI_PIPELINE_SOURCE == "merge_request_event" && $CI_MERGE_REQUEST_SOURCE_PROJECT_ID == $CI_PROJECT_ID
  environment:
    name: datadouble/shop/mr-$CI_MERGE_REQUEST_IID
    on_stop: datadouble-shop-release-1
  variables:
    DATADOUBLE_CI_JOB: provision
    DATADOUBLE_IMAGE: ghcr.io/datadouble/datadouble:v1.2.3
    DATADOUBLE_USER: 999:999
    DATADOUBLE_MOUNTS: |
      /srv/datadouble/staging
    DATADOUBLE_ENVIRONMENT: |
      ALERTS_WEBHOOK
    DATADOUBLE_ARGUMENTS: |
      replicate
      --spec
      datadouble/shop.yml
      --owner
      mr-$CI_MERGE_REQUEST_IID
datadouble-shop-release-1:
  extends: .datadouble
  tags:
  - staging
  - linux
  resource_group: datadouble-shop-release
  timeout: 60m
  rules:
  - if: $CI_PIPELINE_SOURCE == "merge_request_event" && $CI_MERGE_REQUEST_SOURCE_PROJECT_ID == $CI_PROJECT_ID
    when: manual
    allow_failure: true
  environment:
    name: datadouble/shop/mr-$CI_MERGE_REQUEST_IID
    action: stop
  variables:
    DATADOUBLE_CI_JOB: release
    DATADOUBLE_IMAGE: ghcr.io/datadouble/datadouble:v1.2.3
    DATADOUBLE_USER: 999:999
    DATADOUBLE_MOUNTS: |
      /srv/datadouble/staging
    DATADOUBLE_ENVIRONMENT: |
      ALERTS_WEBHOOK
    DATADOUBLE_ARGUMENTS: |
      release
      --spec
      datadouble/shop.yml
      --owner
      mr-$CI_MERGE_REQUEST_IID
datadouble-shop-release-2:
  extends: .datadouble
  tags:
  - staging
  - linux
  resource_group: datadouble-shop-release
  timeout: 60m
  rules:
  - if: $DATADOUBLE_JOB == "shop-release" && $CI_PIPELINE_SOURCE =~ /^(api|schedule|trigger|web)$/
  variables:
    DATADOUBLE_CI_JOB: release
    DATADOUBLE_IMAGE: ghcr.io/datadouble/datadouble:v1.2.3
    DATADOUBLE_USER: 999:999
    DATADOUBLE_MOUNTS: |
      /srv/datadouble/staging
    DATADOUBLE_ENVIRONMENT: |
      ALERTS_WEBHOOK
    DATADOUBLE_ARGUMENTS: |
      release
      --spec
      datadouble/shop.yml
      --expired
datadouble-shop-prune-non-production:
  extends: .datadouble
  tags:
  - staging
  - linux
  resource_group: datadouble-shop-prune-non-production
  timeout: 60m
  rules:
  - if: $DATADOUBLE_JOB == "shop-prune-non-production" && $CI_PIPELINE_SOURCE =~ /^(api|schedule|trigger|web)$/
  variables:
    DATADOUBLE_CI_JOB: prune
    DATADOUBLE_IMAGE: ghcr.io/datadouble/datadouble:v1.2.3
    DATADOUBLE_USER: 999:999
    DATADOUBLE_MOUNTS: |
      /srv/datadouble/staging
    DATADOUBLE_ENVIRONMENT: |
      ALERTS_WEBHOOK
    DATADOUBLE_ARGUMENTS: |
      prune
      --spec
      datadouble/shop.yml
      --target
      staging
      $DATADOUBLE_DRY_RUN
datadouble-shop-activate:
  extends: .datadouble
  tags:
  - staging
  - linux
  resource_group: datadouble-shop-activate
  timeout: 60m
  rules:
  - if: $DATADOUBLE_JOB == "shop-activate" && $CI_PIPELINE_SOURCE =~ /^(api|trigger|web)$/
  variables:
    DATADOUBLE_CI_JOB: activate
    DATADOUBLE_IMAGE: ghcr.io/datadouble/datadouble:v1.2.3
    DATADOUBLE_USER: 999:999
    DATADOUBLE_MOUNTS: |
      /srv/datadouble/staging
    DATADOUBLE_ENVIRONMENT: |
      ALERTS_WEBHOOK
    DATADOUBLE_ARGUMENTS: |
      activate
      $DATADOUBLE_GENERATION
      --spec
      datadouble/shop.yml
